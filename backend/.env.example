# Backend Environment Variables
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/homestay_db
SPRING_DATASOURCE_USERNAME=homestay_user
SPRING_DATASOURCE_PASSWORD=homestay_password

# MinIO S3
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_PHOTOS=listing-photos
MINIO_BUCKET_DOCS=identity-documents

# Mailpit
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025

# Mock Gateway
MOCK_GATEWAY_URL=http://localhost:8081
MOCK_GATEWAY_SECRET=dev-secret-key-32-chars-minimum!
