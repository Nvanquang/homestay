# ==========================================
# CẤU HÌNH MÔI TRƯỜNG DỰ ÁN HOMESTAY BOOKING
# ==========================================

# 1. Cơ sở dữ liệu (PostgreSQL + PostGIS)
POSTGRES_DB=homestay_db
POSTGRES_USER=homestay_user
POSTGRES_PASSWORD=homestay_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/homestay_db

# 2. Lưu trữ tệp tin (MinIO S3 Local)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_PUBLIC=listing-photos
MINIO_BUCKET_PRIVATE=identity-documents

# 3. Mailpit (SMTP Local giả lập)
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# 4. Cổng thanh toán giả lập (Mock Payment Gateway)
MOCK_PAYMENT_GATEWAY_URL=http://localhost:8081
MOCK_GATEWAY_SECRET_KEY=dev-secret-key-32-chars-minimum!

# 5. Frontend & Backend URLs
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
